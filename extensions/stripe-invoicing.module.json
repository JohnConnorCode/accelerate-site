        "serviceTarget": "revenue-os.billing-workspace",
        "connectionRequirement": "none",
        "impact": "read",
        "confirmationRequired": false,
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "actionId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          },
          "required": ["actionId"],
          "additionalProperties": false
        }
      },
      {
        "operation": "get-billing-records",
        "name": "get_billing_records",
        "description": "Read five current Stripe invoices or payments, source amounts, account mode and a next-page cursor. Includes account records outside this workspace. Never sum currencies or describe one page as an account total.",
        "serviceTarget": "revenue-os.billing-workspace",
        "connectionRequirement": "none",
        "impact": "read",
        "confirmationRequired": false,
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "kind": { "type": "string", "enum": ["invoices", "payments"] },
            "cursor": { "type": "string", "maxLength": 124 },
            "connection": { "type": "string", "maxLength": 160 }
          },
          "required": ["kind"],
          "additionalProperties": false
        }
      },
      {
        "operation": "preview-billing-change",
