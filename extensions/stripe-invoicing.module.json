                  "type": "object",
                  "properties": {
                    "operation": { "type": "string", "const": "refund_payment" },
                    "chargeId": { "type": "string", "pattern": "^ch_[A-Za-z0-9]{1,120}$" },
                    "amount": { "type": "integer", "exclusiveMinimum": 0, "maximum": 100000000 },
                    "reason": { "type": "string", "enum": ["requested_by_customer", "duplicate"] },
                    "requestId": {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
