        "description": "Stage the exact previewed Meeting commitments for human approval. Use its digest and a stable UUID requestId. Never executes the action.",
        "serviceTarget": "revenue-os.workflow-plugins",
        "connectionRequirement": "none",
        "impact": "internal_write",
        "confirmationRequired": true,
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "input": {
              "type": "object",
              "properties": {
                "meetingId": {
                  "type": "string",
                  "format": "uuid",
