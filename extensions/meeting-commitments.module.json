            "required": ["title", "description", "dueDate", "assigneeUserId"],
            "additionalProperties": false
          }
        }
      },
      "required": ["meetingId", "tasks"],
      "additionalProperties": false
    },
    "actions": ["create_task_batch"],
    "sources": [
      {
        "name": "meeting",
        "type": "workflow_meetings",
        "columns": ["id", "title", "start_at"],
        "inputKey": "meetingId"
      }
    ],
    "inputContract": "task-batch-meeting-v1",
    "policy": {
      "version": 1,
      "action": "create_task_batch",
      "trustCeiling": "always-propose",
      "evidence": {
        "kind": "canonical-record",
        "inputKey": "meetingId",
        "sourceType": "workflow_meetings"
      },
      "idempotency": { "request": "workflow-request-v1", "effect": "task-content-sha256-v1" },
      "tier": 2,
      "impact": "internal_write",
      "reversibility": "compensable"
    },
    "contractHash": "a053d422379740af869010189c3a7b1e4f175947edcf51f7b37f42e76b049cd2",
