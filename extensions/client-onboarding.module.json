{
  "$schema": "./module-manifest.schema.json",
  "id": "client-onboarding",
  "name": "Client onboarding",
  "description": "Turn a won deal into an assigned, dated delivery checklist with durable task receipts.",
  "category": "delivery",
  "defaultEnabled": false,
  "navLinks": [
    {
      "id": "client-onboarding",
      "label": "Client onboarding",
      "href": "/admin/client-onboarding",
      "icon": "ListChecks",
      "description": "Turn a won deal into an assigned, dated delivery checklist with durable task receipts.",
      "moreGroup": "Delivery"
    }
  ],
  "routes": ["/admin/client-onboarding"],
  "aiToolNames": ["prepare_client_onboarding", "propose_client_onboarding"],
  "workflow": {
    "version": 1,
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["opportunityId", "tasks"],
      "properties": {
        "opportunityId": {
          "type": "string",
          "minLength": 36,
          "maxLength": 36
        },
        "tasks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "description", "dueDate", "assigneeUserId"],
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "description": {
                "type": "string",
                "maxLength": 2000
              },
              "dueDate": {
                "type": "string",
                "minLength": 10,
                "maxLength": 10
              },
              "assigneeUserId": {
                "type": "string",
                "minLength": 36,
                "maxLength": 36
              }
            }
          }
        }
      }
    },
    "actions": ["create_task_batch"],
    "sources": [
      {
        "name": "opportunity",
        "type": "workflow_opportunities",
        "columns": ["id", "name", "stage"],
        "inputKey": "opportunityId"
      }
    ]
  }
}
