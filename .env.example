# Core site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
ADMIN_EMAIL=admin@example.com

# Supabase browser and server access
# Dashboard: Project Settings -> API. NEXT_PUBLIC_SUPABASE_URL and the anon
# key are on that page; SUPABASE_SERVICE_ROLE_KEY is the "service_role" key
# on the same page, under "Reveal".
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# PostgreSQL migration tooling
# Dashboard: Project Settings -> Database -> Connection pooling (Session
# mode). SUPABASE_PROJECT_REF is the project ref shown there and in your
# project URL; SUPABASE_DB_HOST is the exact pooler host listed on that page
# for YOUR project's region (it is not the same for every project, and
# there is no default: migration tooling fails closed if this is unset).
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_DB_HOST=your-pooler-host.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_USER=postgres.your-project-ref
SUPABASE_DB_PASSWORD=use-a-local-secret-manager
# Optional on macOS instead of SUPABASE_DB_PASSWORD:
# SUPABASE_DB_KEYCHAIN_SERVICE=your-keychain-service-name

# Email
RESEND_API_KEY=re_your_key
RESEND_FROM_EMAIL=Example Business <hello@example.com>
RESEND_WEBHOOK_SECRET=whsec_your_signing_secret

# AI gateway and model routing
# The environment key is a bootstrap-only fallback. Prefer tenant-owned keys.
OPENROUTER_API_KEY=sk-or-v1-your-key
OPENROUTER_MODEL=your-default-model
OPENROUTER_FALLBACK_MODEL=your-optional-fallback-model
GOOGLE_TOKEN_ENCRYPTION_KEY=generate-a-long-independent-random-value

# Scheduled and administrative endpoints
CRON_SECRET=generate-a-long-random-value
REVALIDATION_SECRET=generate-a-long-random-value
CAMPAIGN_AUTOMATION_ENABLED=false
CAMPAIGN_GLOBAL_DAILY_LIMIT=10

# Optional Google Workspace OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Optional Calendly attribution
CALENDLY_ENABLED=false
CALENDLY_PERSONAL_ACCESS_TOKEN=your-calendly-token
CALENDLY_WEBHOOK_SECRET=generate-a-long-random-value

# Optional analytics
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=example.com
PLAUSIBLE_API_KEY=your-plausible-api-key
NEXT_PUBLIC_GTAG_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GSC_VERIFICATION=

# Maintainer-only production isolation proof
# Only needed to run `npm run verify:tenant-production-isolation`, a controlled
# mutation drill against ONE Supabase project you explicitly pin here. Never
# point this at a project holding real customer data.
ISOLATION_PROOF_PROJECT_REF=your-project-ref

# Bootstrap tenant identity overrides (optional)
# migrations/20260830-shared-database-tenancy.sql and
# supabase/migration-prompt3.sql seed a bootstrap tenant's identity into the
# database on first apply. Unset, these default to the reference Accelerate
# deployment's own brand, founder, and booking details. Set the ones relevant
# to you BEFORE running npm run db:migrate / db:migrate:all on a fresh
# project so your fork does not inherit Accelerate's identity.
# BOOTSTRAP_BRAND_NAME=Your Business
# BOOTSTRAP_BRAND_DOMAIN=yourbusiness.example
# BOOTSTRAP_BRAND_SITE_URL=https://www.yourbusiness.example
# BOOTSTRAP_BRAND_SITE_URL_BARE=https://yourbusiness.example
# BOOTSTRAP_BRAND_ACCENT_COLOR=#000000
# BOOTSTRAP_BRAND_TAGLINE=Your tagline
# BOOTSTRAP_BRAND_EMAIL_FOOTER=Your Business · Your footer line
# BOOTSTRAP_FOUNDER_NAME=Your Name
# BOOTSTRAP_FOUNDER_FULL_NAME=Your Full Name
# BOOTSTRAP_FOUNDER_EMAIL=you@yourbusiness.example
# BOOTSTRAP_SYSTEM_ACTOR_EMAIL=system@yourbusiness.example
# BOOTSTRAP_AI_DESCRIPTOR=Your Business, a description of what you do
# BOOTSTRAP_AI_VOICE=How the AI should sound
# BOOTSTRAP_AI_POSITIONING=How you want the AI to describe your business
# BOOTSTRAP_BOOKING_URL=https://yourbusiness.example/contact
# BOOTSTRAP_BOOKING_PATH=/contact
# BOOTSTRAP_SCHEDULER_URL=https://calendly.com/you/30min
# BOOTSTRAP_SETTINGS_FROM_EMAIL=you@yourbusiness.example
# BOOTSTRAP_SETTINGS_ADMIN_EMAIL=you@yourbusiness.example
