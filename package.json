{
  "name": "accelerate-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "verify:articles": "npx tsx scripts/verify-articles.ts",
    "deploy:check": "vercel whoami && vercel teams ls",
    "deploy:pull": "vercel pull --yes --environment=production",
    "deploy:build": "vercel build --prod",
    "deploy:upload": "vercel deploy --prebuilt --prod --archive=tgz",
    "deploy": "npm run deploy:pull && npm run deploy:build && npm run deploy:upload",
    "deploy:rollback": "vercel rollback",
    "verify:guardrails": "npx tsx scripts/verify-guardrails.ts",
    "verify:admin-tokens": "node scripts/verify-admin-tokens.mjs",
    "verify:agent-contract": "node scripts/verify-agent-contract.mjs",
    "test:features": "node --env-file=.env.local scripts/qa-feature-board.mjs",
    "test:today": "node --env-file=.env.local scripts/qa-today-command-center.mjs",
    "test:admin-recovery": "node --env-file=.env.local scripts/qa-admin-recovery.mjs",
    "test:admin-parity": "node --env-file=.env.local scripts/qa-admin-route-parity.mjs",
    "test:contact-imports": "node --env-file=.env.local scripts/qa-contact-importer.mjs",
    "test:contact-import-production": "node --env-file=.env.local scripts/qa-contact-import-production.mjs",
    "test:contact-import-service": "NODE_OPTIONS=--conditions=react-server npx tsx scripts/test-contact-imports.ts",
    "test:identity-resolution": "NODE_OPTIONS=--conditions=react-server npx tsx scripts/test-identity-resolution.ts",
    "test:pipeline-transition": "NODE_OPTIONS=--conditions=react-server npx tsx scripts/test-pipeline-transition.ts",
    "verify:inbound-canonical": "NODE_OPTIONS=--conditions=react-server npx tsx --env-file=.env.local scripts/verify-inbound-canonical.ts",
    "verify:recorded-send": "NODE_OPTIONS=--conditions=react-server npx tsx --env-file=.env.local scripts/verify-recorded-send.ts",
    "verify:attribution-loop": "NODE_OPTIONS=--conditions=react-server npx tsx --env-file=.env.local scripts/verify-attribution-loop.ts",
    "verify:ai-gateway": "NODE_OPTIONS=--conditions=react-server npx tsx --env-file=.vercel/.env.production.local scripts/verify-ai-gateway.ts",
    "verify:operator-surfaces": "NODE_OPTIONS=--conditions=react-server npx tsx --env-file=.env.local scripts/verify-operator-surfaces.ts",
    "verify:recorded-send-failure": "RESEND_API_KEY=re_invalid_key_for_verification NODE_OPTIONS=--conditions=react-server npx tsx --env-file=.env.local scripts/verify-recorded-send.ts --mode=provider-failure",
    "test:schema-verification": "NODE_OPTIONS=--conditions=react-server npx tsx scripts/test-schema-verification.ts",
    "test:secret-storage": "NODE_OPTIONS=--conditions=react-server npx tsx scripts/test-secret-storage.ts",
    "test:founder-access": "NODE_OPTIONS=--conditions=react-server npx tsx scripts/test-founder-access.ts",
    "test:api-contracts": "NODE_OPTIONS=--conditions=react-server npx tsx scripts/test-api-contract-basics.ts",
    "test:webhook-cron-defense": "NODE_OPTIONS=--conditions=react-server npx tsx scripts/test-webhook-cron-defense.ts",
    "test:legacy-reconciliation": "NODE_OPTIONS=--conditions=react-server npx tsx scripts/test-legacy-reconciliation.ts",
    "report:legacy-reconciliation": "NODE_OPTIONS=--conditions=react-server npx --yes tsx --env-file=.env.local -- scripts/legacy-reconciliation-report.ts",
    "qa:setup-mobile": "NODE_OPTIONS=--conditions=react-server npx tsx scripts/qa-setup-mobile.ts",
    "seed:features": "node --env-file=.env.local scripts/seed-feature-backlog.mjs",
    "db:migrate": "node scripts/run-migration.mjs",
    "db:verify-schema": "tsx scripts/verify-revenue-schema.ts",
    "test:job-claims": "node scripts/qa-job-claims.mjs",
    "test:campaign-stops": "NODE_OPTIONS=--conditions=react-server npx tsx scripts/test-campaign-stops.ts",
    "test:campaign-stop-claims": "node scripts/qa-campaign-stop-claims.mjs",
    "test:gmail-sync-plan": "npx tsx scripts/test-gmail-sync-plan.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@gsap/react": "^2.1.2",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.1.6",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@react-pdf/renderer": "^4.3.2",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "clsx": "^2.1.1",
    "framer-motion": "^12.34.3",
    "gray-matter": "^4.0.3",
    "gsap": "^3.14.2",
    "lenis": "^1.3.23",
    "lucide-react": "^0.575.0",
    "nanoid": "^5.1.6",
    "next": "16.1.6",
    "next-mdx-remote": "^6.0.0",
    "next-themes": "^0.4.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "reading-time": "^1.5.0",
    "recharts": "^3.7.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.9.3",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "playwright": "^1.58.2",
    "puppeteer": "^24.37.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
